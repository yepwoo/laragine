{
    "name": "yepwoo/laragine",
    "description": "Laravel Engine: Develop Faster And Cleaner!",
    "keywords": [
        "yepwoo",
        "laragine",
        "laravel",
        "module",
        "modules",
        "fast",
        "faster",
        "clean code"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/yepwoo/laragine/issues",
        "source": "https://github.com/yepwoo/laragine"
    },
    "authors": [
      {
          "name": "Mahmood Ahmad",
          "email": "mahmood073@gmail.com"
      },
      {
          "name": "Abdlrahman Saber",
          "email": "abdlrahmansaber652@gmail.com"
      }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5.50|^12.5.8",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Yepwoo\\Laragine\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Yepwoo\\Laragine\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yepwoo\\Laragine\\ModuleServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "test-lv": "vendor/bin/testbench"
    },
    "prefer-stable": true
  }
